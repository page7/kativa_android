<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark-theme window/splash backdrop.

      This exists purely so the *system* splash window (Android 12+, created from the activity
      theme before the process can run any code) uses the dark backdrop. KativaApp mirrors the
      user's theme choice into `AppCompatDelegate.setDefaultNightMode`, so "app theme = Dark"
      selects this file even when the device itself is in light mode. See AGENTS.md §6.
    -->
    <color name="kativa_window_background">#FF0B0B0F</color>
</resources>
